---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CareerCard from '@/components/CareerCard.astro';
import Link from '@/components/Link.astro';
import PageHead from '@/components/PageHead.astro';
import { CAREER_DATA, CAREER_START_YEAR } from '@/data/career';
import Layout from '@/layouts/Layout.astro';

const EXPERIENCE_YEARS = new Date().getFullYear() - CAREER_START_YEAR;
---

<Layout>
  <PageHead
    slot="head"
    title="Career"
    description="Professional experience and career journey"
  />
  <Breadcrumbs
    items={[{ label: 'Career', href: '/career', icon: 'lucide:briefcase' }]}
  />

  <section class="flex flex-col gap-y-6 px-4 py-8 sm:px-8 lg:px-16">
    <div>
      <h1 class="font-custom text-foreground text-4xl font-bold">Career</h1>
      <p class="text-muted-foreground mt-2 text-base">
        Overall I have <span class="text-foreground font-semibold"
          >{EXPERIENCE_YEARS}+ years of experience</span
        > in software engineering.
      </p>
      <p class="text-muted-foreground mt-2 text-xs">
        For the full timeline and details, check out my <Link
          href="https://www.linkedin.com/in/mimukit/"
          external
          underline
          class="text-foreground font-semibold"
        >
          LinkedIn profile
        </Link>.
      </p>
    </div>

    <div class="mt-4 flex flex-col gap-y-6">
      {CAREER_DATA.map((position) => <CareerCard position={position} />)}
    </div>
  </section>
</Layout>
