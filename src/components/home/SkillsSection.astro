---
import Skills from '@/components/react/skills';
---

<section class="relative px-4 sm:px-8 lg:px-16" aria-labelledby="skills-title">
  <h2
    id="skills-title"
    class="font-custom text-foreground text-2xl font-bold"
    title="skills"
    aria-label="skills"
    role="heading"
  >
    Skills & Technologies
  </h2>
  <p class="text-muted-foreground text-sm" aria-label="skills description">
    Below is a selection of technologies with which I have significant
    professional experience:
  </p>
  <div>
    <Skills client:load />
  </div>
</section>
