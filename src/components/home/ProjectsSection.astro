---
import Link from '@/components/Link.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { buttonVariants } from '@/components/ui/button';
import type { getTopProjects } from '@/lib/data-utils';

interface Props {
  projects: Awaited<ReturnType<typeof getTopProjects>>;
}

const { projects } = Astro.props;
---

<section
  class="flex flex-col gap-y-4 px-4 sm:px-8 lg:px-16"
  aria-labelledby="projects-title"
  role="region"
>
  <div class="relative" aria-labelledby="projects-title">
    <h2
      id="projects-title"
      class="font-custom text-foreground text-2xl font-bold"
      title="projects"
      aria-label="projects"
    >
      Projects
    </h2>
    <p class="text-muted-foreground text-sm" aria-label="projects description">
      Here are some of my recent projects. You can find more on my projects
      page.
    </p>
  </div>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
  <div class="flex justify-center" aria-label="see all projects">
    <Link
      href="/projects"
      class={buttonVariants({ variant: 'ghost' }) + ' group'}
    >
      See all projects <span
        class="ml-1.5 transition-transform group-hover:translate-x-1"
        >&rarr;</span
      >
    </Link>
  </div>
</section>
