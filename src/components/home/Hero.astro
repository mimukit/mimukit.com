---
import Logo from '@/components/ui/logo';
import { SITE } from '@/consts';
---

<section
  class="flex flex-col gap-y-12 px-4 py-8 sm:px-8 lg:px-16"
  aria-label="hero section"
>
  <div
    class="flex flex-col items-center text-center sm:flex-row sm:items-start sm:gap-8 sm:text-left"
  >
    <div class="mt-8 sm:mt-0 sm:max-w-xl">
      <h1
        class="font-custom text-foreground text-start text-4xl font-extrabold sm:text-5xl"
      >
        {SITE.title}
      </h1>
      <div class="mt-4 flex items-center gap-2" aria-label="location">
        <span class="text-foreground text-sm font-medium"> I'm from </span>
        <span class="flex items-center gap-1">
          <span
            class="bg-primary text-primary-foreground ring-primary/30 rounded-full px-3 py-1 text-sm font-medium ring-1"
          >
            {SITE.location}
          </span>
        </span>
      </div>
      <p
        class="text-md text-foreground mt-4 text-start font-sans"
        title="description"
        aria-label="description"
      >
        {SITE.description}
      </p>
    </div>

    <div
      class="relative my-8 overflow-hidden rounded-lg sm:my-0 sm:shrink-0 sm:overflow-hidden sm:rounded-lg"
    >
      <Logo className="h-auto w-40 object-cover sm:w-48 md:w-56 lg:w-64" />
    </div>
  </div>
</section>
